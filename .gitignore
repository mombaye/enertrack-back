__pycache__/
*.py[cod]
ml/models/*.pkl
.env
.secrets/
# Fichiers de référence carburant suivis explicitement (voir plus bas) —
# tout le reste de ce dossier (brouillons, exports ponctuels non encore
# reliés à une commande d'import) reste ignoré par défaut.
data_imports/*
!data_imports/base_ge.xlsx
!data_imports/base_aout_26.xlsx
!data_imports/synthese_conso_fuel_juillet_2026.xlsb
!data_imports/commande_fuel_aout_2026.xlsb
!data_imports/esco_facturation_sept26.xlsx
# Fichiers Stan mensuels — déposés sur le serveur dans data_imports/stan/,
# non commités (trop lourds + données opérationnelles confidentielles).
!data_imports/stan/
data_imports/stan/*.xlsx
data_imports/stan/*.xlsb
# Liste des sites GRID — dossier dev avec un CSV de test commité.
# En prod le vrai fichier est à /mnt/ESCO/… (GRID_SITES_LIST_DIR dans .env).
!data_imports/grid_sites/
!data_imports/grid_sites/Listes_Sites_GRID_sample.csv
celerybeat-schedule
